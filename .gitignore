# See COMMIT_NOTES.md for what is and isn't committed, and why.

# macOS / editor clutter
.DS_Store
__pycache__/
.ipynb_checkpoints/

# YOLO weights: large (yolov8x-pose.pt is over GitHub's 100 MB limit);
# Ultralytics downloads them automatically by name
*.pt

# Generated per camera by the Detection scripts (regenerable).
# Calibration files in Data/Sites/<site>/<cam>/ itself are tracked normally.
Data/Sites/*/*/detections/
Data/Sites/*/*/checks/

# Test notebooks' own output folders
Test/*/Outputs/

# Files set aside for deletion
_to_delete/

# Local secrets and environments
.env
.venv/
